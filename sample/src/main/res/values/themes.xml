<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge to edge under the real status bar, drawn behind the cutout (Immersive.kt). Android 12+ system splash:
         values-v31/themes.xml. -->
    <style name="Theme.A7Sample" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/a7_splash</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="a7_splash">#262551</color>
</resources>
