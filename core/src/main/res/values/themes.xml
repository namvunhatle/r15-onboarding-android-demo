<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen, drawn behind the cutout. Android 12+ system splash: values-v31/themes.xml. -->
    <style name="A7" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/a7_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="a7_splash">#262551</color>
</resources>
