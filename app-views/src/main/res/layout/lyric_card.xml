<?xml version="1.0" encoding="utf-8"?>
<!-- A7 / Lyric Card. Opaque on purpose: any see-through lets the phone's own "SAM" ghost through. -->
<namvunhatle.r15.onboarding.views.CssBox xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="card"
    android:layout_width="312dp" android:layout_height="230dp"
    android:layout_marginLeft="24dp" android:layout_marginTop="414dp"
    app:fill="#221C2C" app:fill2="#121018" app:fillAngle="180"
    app:cornerRadius="24dp" app:strokeColor="#1AFFFFFF" app:strokeWidth="1dp"
    app:shadowY="20dp" app:shadowBlur="40dp" app:shadowColor="#59000000">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/T.Meta" android:layout_width="wrap_content" android:textColor="#F5FFFFFF" android:text="Morning Glow" />
            <TextView style="@style/T.Meta" android:fontFamily="@font/bevietnampro_regular" android:layout_width="wrap_content" android:layout_marginLeft="8dp" android:textColor="#CCFFFFFF" android:text="· Pop" />
            <TextView style="@style/T.Meta" android:fontFamily="@font/bevietnampro_medium" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginLeft="8dp"
                android:background="@drawable/tag" android:paddingLeft="10dp" android:paddingRight="10dp" android:textColor="#0D0D0D" android:text="Made by AI" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/T.Lyric" android:layout_width="wrap_content" android:textColor="#F5FFFFFF" android:text="Hey" />
            <FrameLayout android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="8dp" android:layout_weight="1">
                <TextView android:tag="pill_sam" style="@style/T.Lyric" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/pill" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="Sam" />
                <TextView android:tag="pill_emma" style="@style/T.Lyric" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/pill" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="Emma" />
                <TextView android:tag="pill_jake" style="@style/T.Lyric" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/pill" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="Jake" />
            </FrameLayout>
        </LinearLayout>

        <TextView style="@style/T.Line" android:layout_width="wrap_content" android:layout_marginTop="8dp" android:textColor="#CCFFFFFF" android:text="calling, lighting up" />
        <TextView style="@style/T.Line" android:layout_width="wrap_content" android:layout_marginTop="8dp" android:textColor="#5CFFFFFF" android:text="your phone, don’t act busy" />

        <namvunhatle.r15.onboarding.views.CssBox android:layout_width="120dp" android:layout_height="8dp" android:layout_marginTop="16dp" app:fill="#0F010101" app:cornerRadius="4dp">
            <View android:layout_width="48dp" android:layout_height="8dp" android:background="#BB4ABF" />
        </namvunhatle.r15.onboarding.views.CssBox>
    </LinearLayout>
</namvunhatle.r15.onboarding.views.CssBox>
